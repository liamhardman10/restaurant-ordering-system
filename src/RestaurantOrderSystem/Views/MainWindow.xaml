<Window x:Class="RestaurantOrderSystem.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantOrderSystem.View"
        mc:Ignorable="d"
        Title="Restaurant Order System" Height="600" Width="900">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2E7D32" Padding="10">
            <TextBlock Text="Restaurant Order Kiosk" 
                       FontSize="28" 
                       Foreground="White" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu Items Panel -->
            <Border Grid.Column="0" Margin="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Menu Items" FontSize="18" FontWeight="Bold" 
                               Margin="10" HorizontalAlignment="Center" Foreground="#2E7D32"/>

                    <ListBox x:Name="MenuItemsControl" Grid.Row="1" Margin="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" 
                                                       Foreground="Gray" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding Category}" FontSize="11" 
                                                           Foreground="Blue" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Price, StringFormat='Price: ${0:F2}'}" 
                                                           FontWeight="Bold" Foreground="Green"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Add" 
                                                Click="AddMenuItem_Click" 
                                                Tag="{Binding Id}"
                                                Background="#4CAF50" 
                                                Foreground="White"
                                                Padding="15,5"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" x:Name="StartNewOrderButton" 
                            Content="Start New Order" 
                            Click="StartNewOrderButton_Click"
                            Background="#2196F3" 
                            Foreground="White"
                            Margin="10"/>
                </Grid>
            </Border>

            <!-- Current Order Panel -->
            <Border Grid.Column="1" Margin="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Current Order" FontSize="18" FontWeight="Bold" 
                               Margin="10" HorizontalAlignment="Center" Foreground="#2E7D32"/>

                    <!-- Order Items List -->
                    <Border Grid.Row="1" Margin="10" BorderBrush="#E0E0E0" BorderThickness="1">
                        <ScrollViewer  Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="OrderItemsPanel">
                                <!-- Added: explicit EmptyOrderText control so FindName/x:Name resolves -->
                                <TextBlock x:Name="EmptyOrderText"
                                           Text="Your order is empty"
                                           Visibility="Collapsed"
                                           FontStyle="Italic"
                                           Foreground="Gray"
                                           Margin="10"
                                           HorizontalAlignment="Center"/>

                                <ItemsControl x:Name="OrderItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Price, StringFormat='${0:F2}'}" 
                                                               Foreground="Green"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="3" Content="❌" 
                                                        Click="RemoveItemButton_Click"
                                                        Tag="{Binding Id}"
                                                        Background="Transparent" 
                                                        BorderThickness="0"
                                                        FontSize="12"
                                                        ToolTip="Remove item"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Discount Section -->
                    <Border Grid.Row="2" Margin="10" Padding="10" BorderBrush="#FF9800" BorderThickness="1" 
                            CornerRadius="3" Background="#FFF3E0">
                        <StackPanel>
                            <TextBlock Text="Apply Discount" FontWeight="Bold" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="DiscountTextBox" Grid.Column="0" 
                                         Margin="0,0,10,0" Padding="5"
                                         ToolTip="Enter discount code (SAVE10, SAVE5, FIXED3)"/>

                                <Button x:Name="ApplyDiscountButton" Grid.Column="1"
                                        Content="Apply" 
                                        Click="ApplyDiscountButton_Click"
                                        Background="#FF9800" 
                                        Foreground="White"/>
                            </Grid>
                            <TextBlock x:Name="DiscountStatusText" FontSize="11" Foreground="Gray" 
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Totals Section -->
                    <Border Grid.Row="3" Margin="10" Padding="15" BorderBrush="#607D8B" 
                            BorderThickness="1" CornerRadius="3" Background="#ECEFF1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal:" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SubtotalText" Grid.Column="1" Text="$0.00"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tax (8%):"/>
                                <TextBlock x:Name="TaxText" Grid.Column="1" Text="$0.00"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Discount:"/>
                                <TextBlock x:Name="DiscountText" Grid.Column="1" Text="$0.00" Foreground="Red"/>
                            </Grid>

                            <Separator Grid.Row="3" Margin="0,10"/>

                            <Grid Grid.Row="4" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total:" FontWeight="Bold" FontSize="16"/>
                                <TextBlock x:Name="TotalText" Grid.Column="1" Text="$0.00" 
                                           FontWeight="Bold" FontSize="16" Foreground="#2E7D32"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <Button x:Name="ClearOrderButton" 
                                Content="Clear Order" 
                                Click="ClearOrderButton_Click"
                                Background="#F44336" 
                                Foreground="White"
                                Margin="0,0,10,0"/>

                        <Button x:Name="CheckoutButton" 
                                Content="💳 Checkout" 
                                Click="CheckoutButton_Click"
                                Background="#2E7D32" 
                                Foreground="White"
                                Padding="30,10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#F5F5F5">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" FontSize="11">Ready. Start by adding items from the menu.</TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="OrderIdText" FontSize="11">Order: #0</TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Item Count Display -->
        <TextBlock x:Name="ItemCountText"
                   Text="0"
                   Margin="5,0,0,0"
                   VerticalAlignment="Center"
                   FontWeight="Bold"
                   FontSize="14"
                   HorizontalAlignment="Right"
                   Grid.RowSpan="2"/>
    </Grid>
</Window>