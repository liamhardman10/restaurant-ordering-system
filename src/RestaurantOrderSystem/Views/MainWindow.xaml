<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Restaurant Order System" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- String to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Custom Styles -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PriceTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
        </Style>

        <Style x:Key="DiscountBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Enhanced Header with Time and Loyalty -->
        <Border Grid.Row="0" Background="#2E7D32" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍽️" FontSize="32" Margin="0,0,15,0"/>
                    <StackPanel>
                        <TextBlock Text="Restaurant Order System" 
                                   FontSize="26" 
                                   Foreground="White" 
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="TimeOfDayText" 
                                   Text="Current Time: Loading..." 
                                   FontSize="12" 
                                   Foreground="#E8F5E9"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Loyalty and Time Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Time Pricing Indicator -->
                    <Border Background="#FF9800" CornerRadius="4" Padding="8,4" Margin="0,0,10,0"
                            ToolTip="Current time-based pricing multiplier">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏰" Margin="0,0,5,0"/>
                            <TextBlock x:Name="PricingMultiplierText" 
                                       Text="1.0x" 
                                       Foreground="White" 
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Loyalty Login -->
                    <Button x:Name="LoginCustomerButton" 
                            Content="👤 Guest" 
                            Click="LoginCustomerButton_Click"
                            Background="#2196F3" 
                            Foreground="White"
                            Padding="10,6"
                            ToolTip="Click to login as loyalty member"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Menu & Combos -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Menu Section -->
                <Border Grid.Row="0" 
                        Background="White"
                        CornerRadius="8"
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1"
                        Margin="0,0,5,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Menu Header -->
                        <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="8,8,0,0" Padding="12">
                            <TextBlock Text="Menu Items" Style="{StaticResource HeaderTextStyle}"/>
                        </Border>

                        <!-- Menu Items List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                            <ItemsControl x:Name="MenuItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" 
                                                Background="White"
                                                CornerRadius="6"
                                                BorderBrush="#E0E0E0" 
                                                BorderThickness="1">
                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="14"/>
                                                    <TextBlock Text="{Binding Description}" 
                                                               FontSize="11" 
                                                               Foreground="#666666" 
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Border Background="#E8F5E9" 
                                                                CornerRadius="4" 
                                                                Padding="4,2">
                                                            <TextBlock Text="{Binding Category}" 
                                                                       FontSize="10" 
                                                                       Foreground="#2E7D32"/>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                                            <TextBlock Text="Base: " FontSize="11" Foreground="Gray"/>
                                                            <TextBlock Text="{Binding BasePrice, StringFormat='${0:F2}'}" 
                                                                       FontSize="11"
                                                                       TextDecorations="Strikethrough"
                                                                       Foreground="Gray"/>
                                                            <TextBlock Text=" → " FontSize="11" Foreground="Gray" Margin="2,0,2,0"/>
                                                            <TextBlock x:Name="DynamicPriceText" 
                                                                       FontWeight="Bold" 
                                                                       Foreground="#2E7D32"
                                                                       FontSize="12"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Grid.Column="1" 
                                                        Content="+ Add" 
                                                        Click="AddMenuItem_Click"
                                                        Tag="{Binding Id}"
                                                        Background="#4CAF50" 
                                                        Foreground="White"
                                                        Padding="12,6"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Combo Meals Section -->
                <Border Grid.Row="1" 
                        Margin="0,5,5,0"
                        Background="#FFF3E0"
                        CornerRadius="8"
                        BorderBrush="#FFB74D"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Combo Header -->
                        <Border Grid.Row="0" Background="#FFECB3" CornerRadius="8,8,0,0" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Combo Deals" Style="{StaticResource HeaderTextStyle}"/>
                                <TextBlock Text="(Save up to 20%)" 
                                           FontSize="12" 
                                           Foreground="#FF9800" 
                                           FontWeight="Bold"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Combo Meals List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
                            <ItemsControl x:Name="ComboMealsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" 
                                                Background="White"
                                                CornerRadius="6"
                                                BorderBrush="#FFB74D" 
                                                BorderThickness="1">
                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="Bold" 
                                                               Foreground="#FF9800"/>
                                                    <TextBlock Text="{Binding Description}" 
                                                               FontSize="11" 
                                                               Foreground="#666666" 
                                                               Margin="0,4,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <TextBlock Text="Regular: " FontSize="11" Foreground="Gray"/>
                                                        <TextBlock Text="{Binding RegularPrice, StringFormat='${0:F2}'}" 
                                                                   TextDecorations="Strikethrough"
                                                                   FontSize="11"
                                                                   Foreground="Gray"/>
                                                        <TextBlock Text=" → " FontSize="11" Foreground="Gray" Margin="2,0,2,0"/>
                                                        <TextBlock Text="{Binding ComboPrice, StringFormat='${0:F2}'}" 
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   Foreground="#2E7D32"/>
                                                        <Border Background="#FFCDD2" 
                                                                CornerRadius="4" 
                                                                Padding="4,2"
                                                                Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Savings, StringFormat='Save ${0:F2}'}" 
                                                                       FontSize="10" 
                                                                       Foreground="#D32F2F"
                                                                       FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Grid.Column="1" 
                                                        Content="Add Combo"
                                                        Click="AddComboButton_Click"
                                                        Tag="{Binding Id}"
                                                        Background="#FF9800"
                                                        Foreground="White"
                                                        Padding="12,6"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,5,0">
                    <Button x:Name="RefreshMenuButton"
                            Content="🔄 Refresh Menu"
                            Click="RefreshMenuButton_Click"
                            Background="#607D8B"
                            Foreground="White"
                            Padding="15,8"
                            ToolTip="Refresh menu and pricing"/>

                    <Button x:Name="StartNewOrderButton"
                            Content="🆕 New Order"
                            Click="StartNewOrderButton_Click"
                            Background="#2196F3"
                            Foreground="White"
                            Padding="15,8"
                            Margin="10,0,0,0"
                            ToolTip="Start a fresh order"/>
                </StackPanel>
            </Grid>

            <!-- Right Column: Current Order -->
            <Border Grid.Column="1" 
                    Margin="5,0,0,0" 
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Order Header with Loyalty Info -->
                    <Border Grid.Row="0" Background="#F8F9FA" CornerRadius="8,8,0,0">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Current Order" Style="{StaticResource HeaderTextStyle}" Margin="0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OrderIdText" Text="Order #0" FontSize="12" Foreground="#666666"/>
                                    <TextBlock x:Name="CustomerInfoText" 
                                               Text=" | Guest" 
                                               FontSize="12" 
                                               Foreground="#2196F3"
                                               Margin="10,0,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Loyalty Badge -->
                            <Border Grid.Column="1" 
                                    x:Name="LoyaltyBadge"
                                    Background="#FFD54F" 
                                    CornerRadius="4" 
                                    Padding="8,4"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="LoyaltyTierText" 
                                               Text="Bronze" 
                                               FontWeight="Bold"
                                               Foreground="#5D4037"/>
                                    <TextBlock x:Name="LoyaltyPointsText" 
                                               Text=" (0 pts)" 
                                               FontSize="10"
                                               Foreground="#5D4037"
                                               Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Order Items -->
                    <Border Grid.Row="1" Margin="10" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="OrderItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Category}" 
                                                                   FontSize="11" 
                                                                   Foreground="#666666"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" 
                                                               x:Name="ItemPriceText"
                                                               Text="{Binding Price, StringFormat='${0:F2}'}" 
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,15,0"/>

                                                    <Button Grid.Column="2" 
                                                            Content="✕" 
                                                            Click="RemoveOrderItem_Click"
                                                            Tag="{Binding Id}"
                                                            Background="Transparent" 
                                                            Foreground="#F44336"
                                                            BorderThickness="0"
                                                            FontSize="12"
                                                            Padding="8"
                                                            ToolTip="Remove item"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Empty Order Message -->
                            <Border Grid.Row="1" 
                                    x:Name="EmptyOrderPanel" 
                                    Background="#F5F5F5" 
                                    Padding="20"
                                    Visibility="Visible">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🛒 Your order is empty" 
                                               FontSize="14" 
                                               FontWeight="Bold"
                                               Foreground="#666666"/>
                                    <TextBlock Text="Add items from the menu or combo deals" 
                                               FontSize="12" 
                                               Foreground="#999999"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Order Summary -->
                    <Border Grid.Row="2" Margin="10" Padding="15" 
                            Background="#F8F9FA" 
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Item Count -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Items: " FontSize="12" Foreground="#666666"/>
                                <TextBlock x:Name="ItemCountText" 
                                           Text="0" 
                                           FontSize="14" 
                                           FontWeight="Bold"
                                           Foreground="#2E7D32"
                                           Margin="2,0,0,0"/>
                            </StackPanel>

                            <!-- Time Discount Badge -->
                            <Border Grid.Column="1" 
                                    x:Name="TimeDiscountBadge"
                                    Style="{StaticResource DiscountBadgeStyle}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="TimeDiscountText" 
                                           Text="Time Discount" 
                                           FontSize="10" 
                                           Foreground="White"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Discount Section -->
                    <Border Grid.Row="3" Margin="10" Padding="12" 
                            Background="#FFF8E1" 
                            BorderBrush="#FFC107" 
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" 
                                       Text="Apply Discount Code" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,8"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="DiscountTextBox" 
                                         Grid.Column="0" 
                                         Padding="8"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Enter discount code: SAVE10, SAVE5, or FIXED3"/>

                                <Button x:Name="ApplyDiscountButton" 
                                        Grid.Column="1" 
                                        Content="Apply"
                                        Click="ApplyDiscountButton_Click"
                                        Background="#FFC107" 
                                        Foreground="White"
                                        Margin="8,0,8,0"/>

                                <Button x:Name="ClearDiscountButton" 
                                        Grid.Column="2" 
                                        Content="Clear"
                                        Click="ClearDiscountButton_Click"
                                        Background="#E0E0E0" 
                                        Foreground="#666666"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Totals and Checkout -->
                    <Border Grid.Row="4" Margin="10" Padding="20" 
                            Background="#E8F5E9" 
                            CornerRadius="8"
                            BorderBrush="#C8E6C9" 
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Totals -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Subtotal:"/>
                                    <TextBlock x:Name="SubtotalText" Grid.Column="1" Text="$0.00"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tax (8%):"/>
                                    <TextBlock x:Name="TaxText" Grid.Column="1" Text="$0.00"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Discounts:"/>
                                        <TextBlock Text=" (Code + Loyalty + Time)" 
                                                   FontSize="10" 
                                                   Foreground="#666666"
                                                   Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TotalDiscountText" Grid.Column="1" Text="$0.00" Foreground="#F44336"/>
                                </Grid>

                                <Separator Margin="0,10,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total:" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock x:Name="TotalText" Grid.Column="1" Text="$0.00" 
                                               FontWeight="Bold" FontSize="18" Foreground="#2E7D32"/>
                                </Grid>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="ClearOrderButton" 
                                        Content="🗑️ Clear Order" 
                                        Click="ClearOrderButton_Click"
                                        Background="#F5F5F5" 
                                        Foreground="#666666"
                                        BorderBrush="#E0E0E0"
                                        Margin="0,0,0,10"
                                        Padding="15,8"/>

                                <Button x:Name="CheckoutButton" 
                                        Content="💳 Checkout" 
                                        Click="CheckoutButton_Click"
                                        Background="#2E7D32" 
                                        Foreground="White"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Padding="40,12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#F5F5F5">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" 
                           FontSize="12" 
                           Foreground="#666666">
                    Ready. Start by adding items from the menu.
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Dynamic Pricing: " FontSize="11" Foreground="#666666"/>
                    <TextBlock x:Name="DynamicPricingStatus" 
                               Text="Active" 
                               FontSize="11" 
                               FontWeight="Bold"
                               Foreground="#2E7D32"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>